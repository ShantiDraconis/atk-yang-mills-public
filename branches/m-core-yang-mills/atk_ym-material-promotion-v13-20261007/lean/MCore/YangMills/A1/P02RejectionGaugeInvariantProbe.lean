import Mathlib

namespace MCore.YangMills.A1

/--
Abstract gauge-action probe.

This contains only:
* closure under the gauge action,
* the group law,
* inverse restoration,
* gauge invariance of the observed spectral gap.

It does NOT contain positivity of the gap.
-/
structure GaugeProbe (G Point : Type*) [Group G] where
  act : G → Point → Point
  gap : Point → NNReal
  one_act : ∀ x, act 1 x = x
  mul_act : ∀ g₁ g₂ x, act (g₁ * g₂) x = act g₁ (act g₂ x)
  gap_invariant : ∀ g x, gap (act g x) = gap x

namespace GaugeProbe

variable {G Point : Type*} [Group G]

/-- Q1: gauge closure is typed by the codomain of act. -/
theorem gaugeClosure (S : GaugeProbe G Point) (g : G) (x : Point) :
    S.act g x = S.act g x := rfl

/-- Q2: identity gauge transformation. -/
theorem gaugeIdentity (S : GaugeProbe G Point) (x : Point) :
    S.act 1 x = x :=
  S.one_act x

/-- Q3: composition follows the group product. -/
theorem gaugeGroupLaw (S : GaugeProbe G Point) (g₁ g₂ : G) (x : Point) :
    S.act g₁ (S.act g₂ x) = S.act (g₁ * g₂) x := by
  symm
  exact S.mul_act g₁ g₂ x

/-- Q4: inverse gauge transformation restores the original configuration. -/
theorem gaugeInverseRestores (S : GaugeProbe G Point) (g : G) (x : Point) :
    S.act g⁻¹ (S.act g x) = x := by
  calc
    S.act g⁻¹ (S.act g x) = S.act (g⁻¹ * g) x := by
      symm
      exact S.mul_act g⁻¹ g x
    _ = S.act 1 x := by simp
    _ = x := S.one_act x

/-- Q5/Q6: the observed gap is constant under gauge transformation. -/
theorem observedGap_gaugeInvariant
    (S : GaugeProbe G Point) (g : G) (x : Point) :
    S.gap (S.act g x) = S.gap x :=
  S.gap_invariant g x

/-- Gauge equivalence generated by one group element. -/
def GaugeEquivalent (S : GaugeProbe G Point) (x y : Point) : Prop :=
  ∃ g : G, S.act g x = y

/-- Q7: gap is constant on a gauge orbit. -/
theorem gap_eq_of_gaugeEquivalent
    (S : GaugeProbe G Point)
    {x y : Point}
    (hxy : GaugeEquivalent S x y) :
    S.gap y = S.gap x := by
  rcases hxy with ⟨g, rfl⟩
  exact S.gap_invariant g x

/-- The actual mass-gap endpoint. -/
def MassGapProperty (S : GaugeProbe G Point) : Prop :=
  ∀ x : Point, (0 : NNReal) < S.gap x

/--
Material producer strong enough to imply the mass-gap endpoint.
The positive lower bound is explicit and uniform over all physical points.
-/
structure UniformPhysicalGapProducer (S : GaugeProbe G Point) where
  Δ : NNReal
  Δ_pos : (0 : NNReal) < Δ
  lower : ∀ x : Point, Δ ≤ S.gap x

/-- Q10 target implication: a genuine uniform positive producer closes the endpoint. -/
theorem producer_implies_massGap
    (S : GaugeProbe G Point)
    (P : UniformPhysicalGapProducer S) :
    MassGapProperty S := by
  intro x
  exact lt_of_lt_of_le P.Δ_pos (P.lower x)

end GaugeProbe

/--
Negative control with a genuine nontrivial group action:
multiplicative integers act by translation on integers, while the observed
gap is identically zero.

Thus closure + inverse + orbit invariance do not force a positive gap.
-/
def toyFreePhoton : GaugeProbe (Multiplicative ℤ) ℤ where
  act := fun g x => x + g.toAdd
  gap := fun _ => (0 : NNReal)
  one_act := by
    intro x
    simp
  mul_act := by
    intro g₁ g₂ x
    simp [add_assoc, add_comm, add_left_comm]
  gap_invariant := by
    intro g x
    rfl

/-- Q8: zero gap is compatible with the full gauge-action laws. -/
theorem toyFreePhoton_zeroGap :
    toyFreePhoton.gap 0 = (0 : NNReal) := rfl

/-- The negative control has a nontrivial gauge orbit. -/
theorem toyFreePhoton_nontrivialOrbit :
    toyFreePhoton.act (.ofAdd 1) 0 = 1 := by
  simp [toyFreePhoton]

/-- Q9: gauge structure and gauge invariance do not imply mass gap. -/
theorem gauge_invariance_does_not_force_mass_gap :
    ¬ GaugeProbe.MassGapProperty toyFreePhoton := by
  intro h
  have hz := h 0
  simpa [toyFreePhoton] using hz

/--
Q10 firewall: the zero-gap negative control cannot inhabit the material
uniform-positive-gap producer.
-/
theorem toyFreePhoton_has_no_uniformPositiveGapProducer :
    ¬ Nonempty (GaugeProbe.UniformPhysicalGapProducer toyFreePhoton) := by
  rintro ⟨P⟩
  have hle : P.Δ ≤ (0 : NNReal) := by
    simpa [toyFreePhoton] using P.lower 0
  exact (not_lt_of_ge hle) P.Δ_pos

/-
Q1  GAUGE_CLOSURE       : gaugeClosure
Q2  IDENTITY            : gaugeIdentity
Q3  GROUP_LAW           : gaugeGroupLaw
Q4  GAUGE_INVERSE       : gaugeInverseRestores
Q5  NO_GROWTH           : must be supplied by a concrete gauge-invariant observable
Q6  GAP_INVARIANCE      : observedGap_gaugeInvariant
Q7  ORBIT_CONSTANCY     : gap_eq_of_gaugeEquivalent
Q8  ZERO_GAP_COMPATIBLE : toyFreePhoton_zeroGap + nontrivial orbit
Q9  NON_PROMOTION       : gauge_invariance_does_not_force_mass_gap
Q10 MATERIAL_SEPARATOR  : UniformPhysicalGapProducer

The remaining OPEN_MATH is not orbit collapse. It is construction of a
genuine physical producer carrying Δ > 0 uniformly, plus the bridge from
the regulated V13 spectral layer to that producer.
-/

#print axioms MCore.YangMills.A1.GaugeProbe.gaugeGroupLaw
#print axioms MCore.YangMills.A1.GaugeProbe.gaugeInverseRestores
#print axioms MCore.YangMills.A1.GaugeProbe.gap_eq_of_gaugeEquivalent
#print axioms MCore.YangMills.A1.GaugeProbe.producer_implies_massGap
#print axioms MCore.YangMills.A1.gauge_invariance_does_not_force_mass_gap
#print axioms MCore.YangMills.A1.toyFreePhoton_has_no_uniformPositiveGapProducer

end MCore.YangMills.A1
