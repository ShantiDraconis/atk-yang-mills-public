import MCore.YangMills.A1.DecayCalculusV7

namespace MCore.YangMills.A1

/-- Canonical integer lattice site in four Euclidean directions. -/
abbrev EuclideanSite4 := Fin 4 → ℤ

/-- Unit step in one of the four Euclidean directions. -/
def unitStep4 (μ : Fin 4) : EuclideanSite4 :=
  fun ν => if ν = μ then 1 else 0

/-- Translation of a four-dimensional lattice site. -/
def translate4 (x v : EuclideanSite4) : EuclideanSite4 :=
  fun μ => x μ + v μ

@[simp] theorem translate4_zero (x : EuclideanSite4) :
    translate4 x (fun _ => 0) = x := by
  funext μ
  simp [translate4]

theorem translate4_add
    (x u v : EuclideanSite4) :
    translate4 (translate4 x u) v =
      translate4 x (fun μ => u μ + v μ) := by
  funext μ
  simp [translate4, add_assoc]

theorem translate4_commute
    (x u v : EuclideanSite4) :
    translate4 (translate4 x u) v =
      translate4 (translate4 x v) u := by
  funext μ
  simp [translate4]
  ring

@[simp] theorem unitStep4_self (μ : Fin 4) :
    unitStep4 μ μ = 1 := by
  simp [unitStep4]

theorem unitStep4_other
    {μ ν : Fin 4}
    (h : ν ≠ μ) :
    unitStep4 μ ν = 0 := by
  simp [unitStep4, h]

/-- The far corner of an oriented elementary plaquette. -/
def plaquetteFarCorner4
    (x : EuclideanSite4)
    (μ ν : Fin 4) : EuclideanSite4 :=
  translate4 (translate4 x (unitStep4 μ)) (unitStep4 ν)

/-- Elementary plaquette geometry is independent of the order of the two
coordinate translations. -/
theorem plaquetteFarCorner4_commute
    (x : EuclideanSite4)
    (μ ν : Fin 4) :
    plaquetteFarCorner4 x μ ν =
      plaquetteFarCorner4 x ν μ := by
  unfold plaquetteFarCorner4
  exact translate4_commute x (unitStep4 μ) (unitStep4 ν)

/-- Explicit binding of an abstract construction's dimension carrier to four
Euclidean coordinate directions.  This is structural only; it carries no
mass-gap or spectral conclusion. -/
structure Canonical4DDimensionBinding
    (C : RegulatedYM4Construction) where
  dimensionEquiv : C.Signature.Dimension ≃ Fin 4

def Canonical4DDimensionBinding.encode
    {C : RegulatedYM4Construction}
    (B : Canonical4DDimensionBinding C) :
    C.Signature.Dimension → Fin 4 :=
  B.dimensionEquiv

def Canonical4DDimensionBinding.decode
    {C : RegulatedYM4Construction}
    (B : Canonical4DDimensionBinding C) :
    Fin 4 → C.Signature.Dimension :=
  B.dimensionEquiv.symm

@[simp] theorem Canonical4DDimensionBinding.decode_encode
    {C : RegulatedYM4Construction}
    (B : Canonical4DDimensionBinding C)
    (d : C.Signature.Dimension) :
    B.decode (B.encode d) = d := by
  exact B.dimensionEquiv.symm_apply_apply d

@[simp] theorem Canonical4DDimensionBinding.encode_decode
    {C : RegulatedYM4Construction}
    (B : Canonical4DDimensionBinding C)
    (μ : Fin 4) :
    B.encode (B.decode μ) = μ := by
  exact B.dimensionEquiv.apply_symm_apply μ

/-- Coordinate displacement generated by one abstract dimension direction. -/
def canonicalStep4
    {C : RegulatedYM4Construction}
    (B : Canonical4DDimensionBinding C)
    (d : C.Signature.Dimension) : EuclideanSite4 :=
  unitStep4 (B.encode d)

/-- Two abstract coordinate directions commute at the lattice-translation
level after canonical four-dimensional encoding. -/
theorem canonical_coordinate_translations_commute
    {C : RegulatedYM4Construction}
    (B : Canonical4DDimensionBinding C)
    (x : EuclideanSite4)
    (d₁ d₂ : C.Signature.Dimension) :
    translate4 (translate4 x (canonicalStep4 B d₁))
      (canonicalStep4 B d₂) =
    translate4 (translate4 x (canonicalStep4 B d₂))
      (canonicalStep4 B d₁) := by
  exact translate4_commute x
    (canonicalStep4 B d₁) (canonicalStep4 B d₂)

