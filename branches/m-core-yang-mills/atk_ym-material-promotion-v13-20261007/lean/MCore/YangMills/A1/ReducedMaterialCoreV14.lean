import MCore.YangMills.A1.MaterialPromotionV13
import MCore.YangMills.A1.CanonicalSameModelBundleV5
import MCore.YangMills.A1.ConcreteSpectralK30V9

namespace MCore.YangMills.A1
namespace Final

/--
Reduced material core for Yang--Mills V14.

This removes two kinds of duplicated input from the V13 promotion payload:
* the physical non-vacuum excitation is derived from A1MaterialWitnessV3
  through PhysicalExcitationReconstructionV4;
* K30 low-spectrum exclusion is derived from the concrete spectral
  realization, rather than supplied as an opaque proposition.

No FINAL_ROOT, K14MassGap, ProofCertificate, or low-spectrum exclusion theorem
is accepted as a field.
-/
structure YMReducedMaterialCoreV14
    (C : RegulatedYM4Construction)
    (F : K20ScientificFrontier)
    (D : K14PhysicalHilbertData)
    (H : K14HamiltonianOperator D)
    (G : K14GapScale D) where

  /- Same regulated Yang--Mills model, already hardened against phantom B3--B5. -/
  material : A1MaterialWitnessV3 C

  /- Sends the genuine regulated non-vacuum excitation into the same physical sector. -/
  reconstruction :
    PhysicalExcitationReconstructionV4 C D H material

  /- Concrete A1 -> physical-state coupling. -/
  stateMap :
    ∀ (a : C.Signature.Regulator) (V : C.Signature.Volume),
      (C.fiber a V).State → D.State

  observableState :
    ∀ (a : C.Signature.Regulator) (V : C.Signature.Volume),
      C.Signature.Observable → D.State

  mappedStatesPhysical :
    ∀ (a : C.Signature.Regulator) (V : C.Signature.Volume)
      (psi : (C.fiber a V).State),
      C.admissible a V → D.physical (stateMap a V psi)

  observableStatesPhysical :
    ∀ (a : C.Signature.Regulator) (V : C.Signature.Volume)
      (A : C.Signature.Observable),
      C.admissible a V → D.physical (observableState a V A)

  /- Constructive 4D continuum and Osterwalder--Schrader reconstruction. -/
  K23 : K23ConstructiveYM4Data F
  hK23 : K23ConstructionInputsHold K23

  constructionFromA1 :
    MeasureInvariance C →
    ObservableInvariance C →
    F.constructiveYM4 ∧
      F.reflectionPositiveReconstruction ∧
      F.physicalHilbertRealization

  /- Uniform infrared clustering and transfer. -/
  S25 : K25ClusteringSystem
  U25 : K25UniformExponentialClustering S25
  B25 : K25ClusteringToInfraredBridge F S25 U25
  hCyc : B25.observableCyclicityStillRequired
  hSemi : B25.semigroupTransferStillRequired

  /- Uniform positive regulated edge and its survival under both limits. -/
  S27 : K27RegulatedGapSystem
  U27 : K27UniformPositiveGap S27
  L27 : K27LimitControl S27
  W27 : K27LimitWitness S27 U27 L27
  B27 : K27ToFrontierBridge F S27 U27 L27 W27

  /-
  Concrete spectral realization. Its low-spectrum exclusion is a theorem
  (realized_exclusion), not a field of this core.
  -/
  spectral : ConcreteSpectralK30DataV9 F D H G

  /-
  Only the three non-spectral K30 scientific witnesses remain:
  physical-sector control, density, and clustering-to-semigroup.
  -/
  spectralWitness : ConcreteSpectralK30WitnessV9 spectral

/--
The exact K30 obligations generated by the reduced material core.
-/
abbrev YMReducedMaterialCoreV14.K30
    {C : RegulatedYM4Construction}
    {F : K20ScientificFrontier}
    {D : K14PhysicalHilbertData}
    {H : K14HamiltonianOperator D}
    {G : K14GapScale D}
    (R : YMReducedMaterialCoreV14 C F D H G) :
    K30SpectralTransferObligations F D H G :=
  R.spectral.toK30Obligations

/--
Reduced material core -> V13 promotion payload.

All endpoint-facing fields are derived:
* excitation fields from reconstruction;
* K30 spectral exclusion from the concrete spectral theorem.
-/
def YMReducedMaterialCoreV14.toPromotionPayload
    {C : RegulatedYM4Construction}
    {F : K20ScientificFrontier}
    {D : K14PhysicalHilbertData}
    {H : K14HamiltonianOperator D}
    {G : K14GapScale D}
    (R : YMReducedMaterialCoreV14 C F D H G) :
    YMMaterialPromotionPayloadV13
      (C := C) (F := F) (D := D) (H := H) (G := G)
      (O := R.K30)
      (S25 := R.S25) (U25 := R.U25)
      (S27 := R.S27) (U27 := R.U27) (L27 := R.L27) (W27 := R.W27) where
  stateMap := R.stateMap
  observableState := R.observableState
  mappedStatesPhysical := R.mappedStatesPhysical
  observableStatesPhysical := R.observableStatesPhysical
  K23 := R.K23
  hK23 := R.hK23
  constructionFromA1 := R.constructionFromA1
  B25 := R.B25
  hCyc := R.hCyc
  hSemi := R.hSemi
  B27 := R.B27
  excitation := R.reconstruction.excitation
  excitationInDomain := R.reconstruction.excitation_in_domain
  excitationPhysical := R.reconstruction.excitation_physical
  excitationOrthogonalVacuum :=
    R.reconstruction.excitation_orthogonal_vacuum
  transferWitness := R.spectralWitness.toK30Witness

/--
The reduced material core promotes mechanically to the existing FINAL_ROOT.
-/
theorem reduced_material_core_promotes_FINAL_ROOT_V14
    {C : RegulatedYM4Construction}
    {F : K20ScientificFrontier}
    {D : K14PhysicalHilbertData}
    {H : K14HamiltonianOperator D}
    {G : K14GapScale D}
    (R : YMReducedMaterialCoreV14 C F D H G) :
    FINAL_ROOT D H G :=
  material_payload_promotes_FINAL_ROOT_V13 R.toPromotionPayload

/--
Nonempty ledger form for the unique reduced material frontier.
-/
def YMReducedMaterialInhabitantV14 : Prop :=
  ∃ (C : RegulatedYM4Construction)
    (F : K20ScientificFrontier)
    (D : K14PhysicalHilbertData)
    (H : K14HamiltonianOperator D)
    (G : K14GapScale D),
    Nonempty (YMReducedMaterialCoreV14 C F D H G)

/--
Fail-closed: defining the reduced frontier does not inhabit it.
-/
theorem REDUCED_MATERIAL_INTERFACE_DOES_NOT_SELF_PROMOTE :
    MCore.k6_dependency.target.status = .openBridge :=
  MCore.final_core_target_still_open

#print axioms MCore.YangMills.A1.Final.YMReducedMaterialCoreV14.toPromotionPayload
#print axioms MCore.YangMills.A1.Final.reduced_material_core_promotes_FINAL_ROOT_V14
#print axioms MCore.YangMills.A1.Final.REDUCED_MATERIAL_INTERFACE_DOES_NOT_SELF_PROMOTE

end Final
end MCore.YangMills.A1
